      "why": "rimraf 3 replaced by fs.rm",
      "replace": [
        [
          "const rimraf = require('rimraf');",
          "const fs = require('fs');"
        ],
        [
          "const rimrafP = promisify(rimraf);",
          "// rimraf 3 (unsupported) is replaced by the recursive fs.rm of Node.js, which deletes the same way.\nconst rmOptions = {recursive: true, force: true, maxRetries: 3};\nconst rimrafP = file => fs.promises.rm(file, rmOptions);"
        ],
        [
          "await rimrafP(file, rimrafOptions);",
          "await rimrafP(file);"
        ],
        [
          "rimraf.sync(file, rimrafOptions);",
          "fs.rmSync(file, rmOptions);"
        ]
      ]
